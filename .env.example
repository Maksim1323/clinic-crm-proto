# Пример имён. Не сохраняйте настоящие значения в этом файле или Git.
# Используется только для первоначального создания первого управляющего.
ADMIN_TOKEN=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Провайдер: gemini (по умолчанию), gigachat или openai.
AI_PROVIDER=gemini
# Время ожидания модели: 10000–120000 мс, по умолчанию 60000.
AI_TIMEOUT_MS=60000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Render задаёт RENDER_EXTERNAL_URL автоматически; используйте PUBLIC_BASE_URL при необходимости.
PUBLIC_BASE_URL=
# Постоянное хранилище: укажите внутренний URL Render PostgreSQL в настройках Render, не в Git.
DATABASE_URL=
# Без DATABASE_URL используется временный файл. На Render /tmp очищается при перезапуске.
DATA_FILE=/tmp/clinic-crm-demo.json
# Автоответ с реальной отправкой в Telegram: включайте только для тестового бота.
AI_AUTO_REPLY=false

# Для прямого GigaChat: ключ авторизации, не временный access_token.
GIGACHAT_AUTH_KEY=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
GIGACHAT_MODEL=GigaChat
# Открытый корневой сертификат для GigaChat уже включён в репозиторий.
# Для OpenAI-совместимого Chat Completions API (сервис должен поддерживать выбранную модель).
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=https://api.openai.com/v1
